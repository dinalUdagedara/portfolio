# Public site origin (no trailing slash). Used for Open Graph / Twitter
# card absolute URLs. Set in Vercel to your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Favicon preset: d | du | code | stack (see docs/favicon-catalog.md)
NEXT_PUBLIC_FAVICON_PRESET=du

# Optional: GitHub PAT for the contribution heatmap (GraphQL viewer query).
# Must belong to the same account as site.githubUsername.
# To match github.com totals (private + org repos), use a classic PAT with
# read:user and repo, and enable “Include private contributions” on your profile.
# Fine-grained Profile-only tokens usually return public activity only (~2k vs ~7k).
# GITHUB_TOKEN=

# Log GitHub fetch details in the server terminal (dev enables this by default).
# GITHUB_DEBUG=true
