# Public site origin (no trailing slash). Used for Open Graph / Twitter
# card absolute URLs. Set in Vercel to your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Favicon preset: d | du | code | stack (see docs/favicon-catalog.md)
NEXT_PUBLIC_FAVICON_PRESET=du

# Optional: GitHub fine-grained or classic PAT for higher API rate limits
# when loading the profile section (public user endpoint only).
# GITHUB_TOKEN=
